{
  "name": "aurora-capabilities",
  "private": true,
  "version": "0.0.0",
  "description": "React components for document computation, composition, recording, redaction, and manifest workflows in the Tabularium AI platform.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Tabularium AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/TabulariumAI/aurora_capabilities.git"
  },
  "bugs": {
    "url": "https://github.com/TabulariumAI/aurora_capabilities/issues"
  },
  "homepage": "https://github.com/TabulariumAI/aurora_capabilities#readme",
  "keywords": [
    "document-processing",
    "document-composition",
    "document-redaction",
    "manifest",
    "react",
    "tabularium-ai"
  ],
  "main": "./src/public-api.ts",
  "module": "./src/public-api.ts",
  "types": "./src/public-api.ts",
  "exports": {
    ".": {
      "types": "./src/public-api.ts",
      "import": "./src/public-api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint:boundary": "node scripts/check-boundary.cjs",
    "test:vitest": "vitest run",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tooltip": "^1.2.16",
    "aurora-core": "file:../aurora_core",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
